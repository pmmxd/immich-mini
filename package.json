{
  "name": "immich-mini",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first, single-user media manager for Windows.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmmxd/immich-mini.git"
  },
  "homepage": "https://github.com/pmmxd/immich-mini",
  "bugs": {
    "url": "https://github.com/pmmxd/immich-mini/issues"
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "npm run build:server && npm run verify:frontend",
    "build:server": "tsc -p tsconfig.server.json",
    "build:launcher": "powershell -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "build:web": "vite build",
    "check": "npm run check:server && npm run verify:frontend",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "check:web": "node scripts/frontend-baseline.mjs",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node --enable-source-maps dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:frontend": "node scripts/frontend-baseline.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "exifr": "^7.1.3",
    "fastify": "^5.6.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.15.0",
    "svelte": "^5.35.0",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
